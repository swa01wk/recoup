# Copy this to .env and fill in values.
# NEVER commit the actual .env file.

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# AgentCore (populated after cdk deploy)
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=

# DynamoDB (default names match CDK; override only if changed)
OPPORTUNITIES_TABLE=recoup-opportunities
APPROVALS_TABLE=recoup-approvals
TOOL_AUDITS_TABLE=recoup-tool-audits
OUTCOME_METADATA_TABLE=recoup-outcome-metadata

# S3 (replace ACCOUNT and REGION after cdk deploy)
EVIDENCE_BUCKET=recoup-evidence-ACCOUNT-REGION
SLA_CATALOG_BUCKET=recoup-sla-catalog-ACCOUNT-REGION
EVAL_FIXTURES_BUCKET=recoup-eval-fixtures-ACCOUNT-REGION
EVIDENCE_KMS_KEY_ID=

# SQS (from CDK output RecoveryEventsQueueUrl)
RECOVERY_EVENTS_QUEUE_URL=

# EC2 Demo (from CDK output DemoInstanceId)
RECOUP_DEMO_INSTANCE_ALLOWLIST=
ALLOWLISTED_DEMO_ACCOUNT_ID=

# Feature flags — keep both false unless intentionally enabling real AWS actions
RECOUP_ENABLE_LIVE_AWS=false
RECOUP_ENABLE_REAL_SUPPORT_SUBMISSION=false

# Cost safety
RECOUP_MAX_REPLAY_RUNS_PER_DAY=100
