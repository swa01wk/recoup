# =============================================================================
# Recoup — Environment Variables Template
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# ── AWS Core ─────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123456789012        # your 12-digit AWS account ID
CDK_DEFAULT_REGION=us-east-1

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Controls which model backend the Strands reasoning agents use.
# Supported values: "bedrock" (default) | "openai"
# Switch to "openai" while Bedrock model access is pending from AWS support.
# Adding a new provider: add _make_<name>() + register in _MODEL_PROVIDERS
#   in backend/src/recoup/agents/strands_agents.py — no other changes needed.
LLM_PROVIDER=bedrock

# OpenAI (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

# ── Bedrock / AgentCore ───────────────────────────────────────────────────────
# Model — Nova Pro is the default (no approval gate, instant access on all accounts)
# Switch to us.anthropic.claude-sonnet-4-6-20250514-v1:0 once Anthropic use-case
# form is approved (new accounts may need to wait a few hours)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
RECOUP_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/RecoupRuntimeRole
RECOUP_GATEWAY_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/RecoupGatewayExecutionRole
RECOUP_AGENTCORE_HARNESS_ID=                  # harness ID (replaces legacy RUNTIME_ID)
RECOUP_AGENTCORE_HARNESS_ARN=                 # harness ARN for invoke_harness calls
RECOUP_AGENTCORE_GATEWAY_ID=                  # gateway ID

# ── DynamoDB ─────────────────────────────────────────────────────────────────
RECOUP_OPPORTUNITIES_TABLE=recoup-opportunities
RECOUP_APPROVALS_TABLE=recoup-approvals
RECOUP_TOOL_AUDITS_TABLE=recoup-tool-audits
RECOUP_OUTCOME_METADATA_TABLE=recoup-outcome-metadata

# ── S3 ───────────────────────────────────────────────────────────────────────
RECOUP_EVIDENCE_BUCKET=recoup-evidence-123456789012-us-east-1
RECOUP_SLA_CATALOG_BUCKET=recoup-sla-catalog-123456789012-us-east-1
RECOUP_EVAL_FIXTURES_BUCKET=recoup-eval-fixtures-123456789012-us-east-1

# ── SQS ──────────────────────────────────────────────────────────────────────
RECOUP_RECOVERY_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/recoup-recovery-events

# ── KMS ──────────────────────────────────────────────────────────────────────
RECOUP_EVIDENCE_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/mrk-...

# ── Lambda Tool ARNs (set after deploying tool Lambdas in Phase 2) ────────────
RECOUP_CW_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-cw-tool
RECOUP_CW_LOGS_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-cw-logs-tool
RECOUP_HEALTH_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-health-tool
RECOUP_COST_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-cost-tool
RECOUP_CLOUDTRAIL_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-cloudtrail-tool
RECOUP_EVIDENCE_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-evidence-tool
RECOUP_APPROVAL_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-approval-tool
RECOUP_SIMULATE_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-simulate-tool
RECOUP_SUPPORT_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-support-tool
RECOUP_EC2_DEMO_TOOL_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:recoup-ec2-demo-tool

# ── SNS Notifications (Phase 6b P1) ──────────────────────────────────────────
# SNS topic ARN for opportunity-detected and EC2-stopped notifications
# Fires when SNS topic is configured and AWS credentials are available
# Subscribe email: swaroop.shivakumar@webknot.in (already confirmed)
RECOUP_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:625962218034:recoup-alerts
# Set to 1 for Playwright / local smoke (no real Publish). Omit for live email test.
# RECOUP_SNS_DRY_RUN=0

# ── AgentCore Gateway (Phase 6b P10) ─────────────────────────────────────────
# Set to recoup-tool-gateway-tpnzqdgixc after registration
# Verify enforcement mode: aws bedrock-agentcore-control describe-gateway
#   --gateway-id recoup-tool-gateway-tpnzqdgixc
# Expected: policyConfig.policyEnforcementMode = ENFORCING
RECOUP_AGENTCORE_GATEWAY_ENFORCEMENT_MODE=ENFORCING

# ── SLA Demo API Gateway (deploy RecoupSLADemoStack + run inject_sla_traffic.py) ──
RECOUP_SLA_DEMO_API_ID=oya8d708h5

# ── EC2 Demo (Phase 6) ────────────────────────────────────────────────────────
# Comma-separated list of instance IDs allowed to be stopped by stop_demo_instance
RECOUP_DEMO_INSTANCE_ALLOWLIST=i-0123456789abcdef0

# ── IAM Security Model — STS AssumeRole (Phase 6e) ───────────────────────────
# Deploy RecoupIamStack first: cd infra/cdk && npx cdk deploy RecoupIamStack
# Copy the CloudFormation outputs into the vars below.
#
# RecoupReadOnlyRole — broad read-only analysis (no write actions anywhere)
RECOUP_READONLY_ROLE_ARN=arn:aws:iam::123456789012:role/RecoupReadOnlyRole
# ExternalId used in the ReadOnly + Remediation role trust policy conditions
RECOUP_EXTERNAL_ID=recoup-demo-external-id
# RecoupRemediationRole — ec2:StopInstances on RecoupDemo=true only; Terminate denied
RECOUP_REMEDIATION_ROLE_ARN=arn:aws:iam::123456789012:role/RecoupRemediationRole

# ── Backend API ───────────────────────────────────────────────────────────────
RECOUP_API_HOST=0.0.0.0
RECOUP_API_PORT=8010
# Real AWS is always used — no simulation mode flags needed.
# Set RECOUP_ENABLE_REAL_SUPPORT_SUBMISSION=true only when ready to file real support cases.
RECOUP_ENABLE_REAL_SUPPORT_SUBMISSION=false

# ── Phase 6f — Scanner thresholds (demo tuning) ───────────────────────────────
# Set to 0 to detect snapshots of any age (demo mode); default 90 days
RECOUP_STALE_SNAPSHOT_DAYS=0
# Set to 1 to detect RDS instances with <1 day of history (demo mode); default 7 days
RECOUP_RDS_LOOKBACK_DAYS=1

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8010
# Phase 6e — pre-fills Role ARN field in Account Scanner for demo
NEXT_PUBLIC_RECOUP_READONLY_ROLE_ARN=arn:aws:iam::123456789012:role/RecoupReadOnlyRole

# ── Monitoring ────────────────────────────────────────────────────────────────
RECOUP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Sprint 4 — Production security hardening ─────────────────────────────────
# API key auth — when set, all non-public API calls require:
#   X-API-Key: <value>   OR   Authorization: Bearer <value>
# Leave empty in local dev; set a strong random secret in production.
RECOUP_API_KEY=

# AWS Secrets Manager ARN — when set, secrets are loaded at startup and override env vars.
# Format: arn:aws:secretsmanager:<region>:<account>:secret:<name>
RECOUP_SECRETS_ARN=

# Sentry DSN — error tracking (optional)
SENTRY_DSN=
